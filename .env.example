# ==============================================================================
# La Casa del Jean V2 - Plantilla de variables de entorno (SIN SECRETOS)
# Copia este archivo a `.env` y reemplaza los valores antes de levantar Docker.
# ==============================================================================

# --- Entorno general ---
APP_ENV=development
LOG_LEVEL=INFO
TZ=America/Bogota

# --- Puertos locales (enlazados a 127.0.0.1 en docker-compose.yml) ---
WEB_PORT=4200
API_PORT=8000

# --- PostgreSQL ---
POSTGRES_DB=lacasadeljean_v2
POSTGRES_USER=lacasadeljean
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql+psycopg://lacasadeljean:CHANGE_ME_STRONG_PASSWORD@postgres:5432/lacasadeljean_v2

# --- Seguridad API (FastAPI) ---
# Generar con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_RANDOM_SECRET_64_CHARS
ACCESS_TOKEN_TTL_MINUTES=60
CORS_ORIGINS=http://127.0.0.1:4200,http://localhost:4200

# --- Bootstrap inicial de administrador (solo al ejecutar python -m app.db.bootstrap_admin) ---
# Nunca commitear credenciales reales.
# BOOTSTRAP_ADMIN_EMAIL=admin@lacasadeljean.com
# BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
# BOOTSTRAP_ADMIN_FULL_NAME=Administrador Principal

# --- Almacenamiento persistente / Pillow ---
MEDIA_ROOT=/app/storage/media
MAX_UPLOAD_MB=10

# --- Hermes Agent v0.23.4 / MCP / Telegram (Fase 3) ---
HERMES_IMAGE_TAG=v0.23.4
HERMES_MCP_URL=http://mcp:8010/mcp
TELEGRAM_BOT_TOKEN=CHANGE_ME_TELEGRAM_BOT_TOKEN
# IDs numéricos de usuarios de Telegram autorizados, separados por coma (ej: 123456789,987654321)
TELEGRAM_ALLOWED_USERS=
# Tiempo de caducidad (en segundos) de propuestas pendientes de confirmación en Telegram
HERMES_PROPOSAL_TTL_SECONDS=120
HERMES_MCP_SHARED_SECRET=CHANGE_ME_MCP_SECRET
MCP_ACTOR_ASSERTION_SECRET=CHANGE_ME_MCP_ACTOR_ASSERTION_SECRET
MCP_APPROVAL_SIGNING_SECRET=CHANGE_ME_MCP_APPROVAL_SIGNING_SECRET
MCP_PORT=8010

# --- Proveedor LLM y STT para Hermes (elegir según plan/facturación; ver docs/fase3-hermes-integration.md) ---
# Opciones LLM: openai (API), openai-codex (OAuth ChatGPT vía `hermes auth add openai-codex`), nous (Nous Portal)
HERMES_LLM_PROVIDER=openai
HERMES_MODEL=gpt-4.1-mini
OPENAI_API_KEY=CHANGE_ME_OPENAI_API_KEY
NOUS_API_KEY=CHANGE_ME_NOUS_API_KEY
# STT integrado en Hermes: proveedor hospedado por defecto (openai o groq); faster-whisper local solo si los recursos lo permiten
HERMES_STT_PROVIDER=openai
HERMES_STT_MODEL=whisper-1
GROQ_API_KEY=CHANGE_ME_GROQ_API_KEY

# --- Cloudflare Tunnel (Fase 4 / Perfil tunnel) ---
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME_CLOUDFLARE_TUNNEL_TOKEN
