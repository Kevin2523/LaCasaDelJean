# Environment & secrets
.env
.env.*
!.env.example

# OS & editor artifacts
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

# Python / FastAPI / Hermes
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Node / Angular / Tailwind
node_modules/
dist/
.angular/
tmp/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Persistent local storage & DB data (keep directory structure via .gitkeep)
storage/media/*
!storage/media/.gitkeep
infra/postgres/data/
*.sql
*.dump
*.bak

# Cloudflare Tunnel credentials (never commit)
infra/cloudflared/*.json
infra/cloudflared/config.yml
!infra/cloudflared/config.example.yml

# Logs
logs/
*.log
